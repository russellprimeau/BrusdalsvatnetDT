# Template for the local .env file. Copy to ".env" and fill in real values.
# .env is ignored by git and must never be committed. This template holds placeholders only.

# --- PostgreSQL database (read-only access is sufficient for the dashboard) ---
DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
schema_name=your-schema

# Tables holding the three datasets (hourly surface data, vertical profiles, weather station)
DB_TABLE_HOURLY=your-hourly-table
DB_TABLE_PROFILES=your-profiles-table
DB_TABLE_WEATHER=your-weather-table

# --- Legacy scrapers only (Scrape*.py); not needed by the dashboard ---
# Base URL of the profiler station's data logger, e.g. http://<logger-address>
PROFILER_LOGGER_URL=http://your-profiler-logger
# Full URL of the weather station logger's table page, and its login
WEATHER_LOGGER_URL=http://your-weather-logger/tables.html
WEATHER_LOGGER_USER=your-username
WEATHER_LOGGER_PASSWORD=your-password
