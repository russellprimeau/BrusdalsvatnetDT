# NOTE: git only treats "#" as a comment at the start of a line, so every comment sits on its own line.

# Secrets: environment variable files and Streamlit secrets (database credentials, logger addresses/logins).
# Only the placeholder template .env.example is tracked.
.env
*.env
!.env.example
.streamlit/secrets.toml

# Python virtual environments used for testing code
venv/
.venv/

# Python bytecode caches
__pycache__/
*.pyc

# Test cache
.pytest_cache/

# PyCharm configuration files
.idea/

# Possibly related to VS Code or Docker; unclear and undesired
.devcontainer/

# Log files generated by the scraping scripts (since print statements are not visible from batch run)
*.log

# Generated by some plotting packages
*.html

# Used to display older iterations of model output
*.geojson

# Temporary file written while db_sync.py rebuilds a CSV
*.csv.tmp
