# Template for Streamlit secrets. Placeholders only: never put real values in this file.
#
# Streamlit Community Cloud: open the app's Settings > Secrets and paste this section with real values.
# Running locally instead of using .env: copy this file to .streamlit/secrets.toml (ignored by git).
#
# Only needed if the deployed app should check the database itself when it starts (and at most every 15 minutes
# while in use). Without it, the app plots the CSVs committed by the GitHub Actions workflow
# (.github/workflows/sync-data.yml) and shows "Database sync not configured" in the sidebar.
# Use a database account with read-only permissions.

[postgres]
DB_HOST = "your-database-host"
DB_PORT = "5432"
DB_NAME = "your-database-name"
DB_USER = "your-read-only-user"
DB_PASSWORD = "your-password"
schema_name = "your-schema"
DB_TABLE_HOURLY = "your-hourly-table"
DB_TABLE_PROFILES = "your-profiles-table"
DB_TABLE_WEATHER = "your-weather-table"
